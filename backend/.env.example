MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=dhan
JWT_SECRET=change-this-in-production
GOOGLE_VISION_API_KEY=

# Public URL of the frontend; Udhaar payment links are built from this.
APP_BASE_URL=http://localhost:5173
REMINDERS_ENABLED=true

# Email (leave blank to simulate; messages then appear in the in-app outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# WhatsApp Cloud API (leave blank to simulate)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Razorpay payment links + webhook (leave blank to hide "Pay online")
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# DHAN AI uses Groq (https://console.groq.com, free tier). Leave the key blank to use the built-in rules engine.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
